import multivariate_nonlinear_baseline as mnb
import func1_kan_model_spdz as approx_func1
import func2_kan_model_spdz as approx_func2
import func3_kan_model_spdz as approx_func3
import func4_kan_model_spdz as approx_func4
import func5_kan_model_spdz as approx_func5
import func6_kan_model_spdz as approx_func6
import func7_kan_model_spdz as approx_func7
import func8_kan_model_spdz as approx_func8
import func9_kan_model_spdz as approx_func9
import func10_kan_model_spdz as approx_func10
import func11_kan_model_spdz as approx_func11
import func12_kan_model_spdz as approx_func12
import func13_kan_model_spdz as approx_func13
import func14_kan_model_spdz as approx_func14
import func15_kan_model_spdz as approx_func15
import itertools, math, os 

program.use_edabit(True)

arg_val = str(program.args[2])

if (arg_val == "0" or arg_val == "1"):
    # 处理 "ring" 的情况
    if (arg_val == "0" or arg_val == "1"):
        program.use_split(3)
    else:
        program.use_split(4)
    print("compiled for ring")
    if (arg_val == "0" or arg_val == "5"):
        program.use_trunc_pr = True
    else:  # arg_val must be "1" here
        program.use_square(True)
else:
    # 处理 "field" 和 "others" 的情况
    if (arg_val == "2" or arg_val == "3"):
        # 处理 "field" 的情况
        print("compiled for field")
    else:
        # 处理其他所有情况
        print("compiled for others")

func_name = str(program.args[1])
N = 1000
# N = 10000
n_vars = mnb.benchmark_dict[func_name]["n_vars"]
domain = mnb.benchmark_dict[func_name]["domain"]
func_approx = eval(f"approx_{func_name}.{func_name}_kan_model_evaluate")
input_file_path = f"/root/llm-project/NFGen+KAN/Results/inputs/{func_name}_input.txt"

sfix.set_precision(48, 96)

# --- START: 修改部分 ---
# 1. 检查输入文件是否存在
if not os.path.exists(input_file_path):
    raise FileNotFoundError(f"输入文件未找到，请先运行数据准备脚本: {input_file_path}")

# 2. 创建矩阵用于存储输入数据
x_matrix = sfix.Matrix(N, n_vars)

# 3. 在编译时从文本文件读取数据并填充矩阵
print_ln("正在从 %s 加载输入数据...", input_file_path)
last_index = -1
with open(input_file_path, 'r') as f:
    # 使用 itertools.islice 来只迭代文件的前 N 行
    for i, line in enumerate(itertools.islice(f, N)):
        # 读取一行，去除首尾空格，按空格分割，并转换为浮点数列表
        row_data = [float(val) for val in line.strip().split()]
        
        # 检查维度是否匹配
        if len(row_data) != n_vars:
            raise ValueError(f"文件第 {i+1} 行的维度 ({len(row_data)}) 与期望的维度 ({n_vars}) 不匹配。")
            
        # 将数据分配给矩阵的当前行
        x_matrix[i].assign(row_data)
        last_index = i

# 如果文件行数少于 N，这是一个严重错误
# last_index 是最后一个成功读取的行的索引（从0开始）
if last_index + 1 < N:
    raise ValueError(f"输入文件 '{input_file_path}' 只包含 {last_index + 1} 行，但程序需要 N={N} 行。")

print_ln("输入数据加载完成。")
# --- END: 修改部分 ---

y_approx_list = Array.create_from([sfix(0) for _ in range(N)])

start_timer(1)
@for_range(N)
def _(i):
    current_x_vector = x_matrix[i]
    y = func_approx(current_x_vector)
    y_approx_list[i] = y[0]
stop_timer(1)

print_ln("Approx res:")
print_float_prec(14)
print_ln("approx = %s", y_approx_list.reveal())